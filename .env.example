PUERTO=3000
ENTORNO=desarrollo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monify
DB_PORT=5433
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/monify
# Genera una clave con: openssl rand -base64 32
ENCRYPTION_KEY=
JWT_SECRET=openssl rand -hex 32
# Genera el par de claves con:
#   openssl genrsa -out rsa_private.pem 2048
#   openssl rsa -in rsa_private.pem -pubout -out rsa_public.pem
# Pega el contenido PEM completo, con los saltos de línea escapados como \n.
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=