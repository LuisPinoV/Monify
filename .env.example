PUERTO=3000
# desarrollo | produccion. La semilla de datos falsos solo corre en desarrollo; cada entorno usa su propia base.
ENTORNO=desarrollo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=monify
DB_PORT=5433
DATABASE_URL=postgresql://postgres:[change-me]@localhost:5433/monify
# Genera una clave con: openssl rand -base64 32
ENCRYPTION_KEY=
#openssl rand -hex 32
JWT_SECRET=
# Genera el par de claves con:
#   openssl genrsa -out rsa_private.pem 2048
#   openssl rsa -in rsa_private.pem -pubout -out rsa_public.pem
# Pega el contenido PEM completo, con los saltos de línea escapados como \n.
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# Bóveda de seudónimos: base de datos separada con los datos personales originales cifrados.
# Si se omite, se usa la misma instancia con el nombre "<base>_vault" (se crea sola al iniciar).
VAULT_DATABASE_URL=

# Primer Admin: se crea al iniciar el servidor solo si no existe ninguno. Borra la contraseña después.
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CONTRASENA=
ADMIN_INICIAL_NOMBRE=
ADMIN_INICIAL_RUT=

# Semilla de desarrollo (pnpm run db:seed): cantidad de titulares ficticios y contraseña común.
SEED_TITULARES=12
SEED_CONTRASENA=
