{
  "name": "macrobots-platform",
  "version": "1.0.0",
  "description": "Plataforma interna de Macrobots",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --no-bail lint",
    "lint:fix": "pnpm -r --no-bail lint:fix",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "docker compose exec -T db sh /docker-entrypoint-initdb.d/90-seed.sh",
    "db:psql": "docker compose exec db psql",
    "db:logs": "docker compose logs -f db"
  }
}