{
  "name": "monify",
  "version": "0.1.0",
  "description": "Billetera digital educativa para practicar ciberseguridad y proteccion de datos",
  "private": true,
  "scripts": {
    "desarrollo": "nest start --watch",
    "compilar": "nest build",
    "iniciar": "node dist/main.js",
    "prueba": "node --test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "nest build && node dist/semilla.js",
    "db:psql": "docker compose exec db psql",
    "db:logs": "docker compose logs -f db",
    "prueba:humo": "node --env-file=.env scripts/prueba-humo.js",
    "prueba:seguridad": "node --env-file=.env scripts/pruebas-seguridad.js",
    "prueba:actividad5": "node --env-file=.env scripts/pruebas-actividad5.js",
    "prueba:actividad6": "node --env-file=.env scripts/pruebas-actividad6.js",
    "prueba:actividad7": "node --env-file=.env scripts/pruebas-actividad7.js",
    "simular:incidente": "node --env-file=.env scripts/Simulacion_Incidente.js",
    "prueba:sanitizador-auditoria": "pnpm run compilar && node --test scripts/prueba-sanitizador-auditoria.js",
    "prueba:e2e-auditoria": "pnpm run compilar && node --env-file=.env --test scripts/auditoria-datos-personales.e2e.js",
    "evidencia:auditoria": "bash scripts/evidencia-auditoria.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.11",
    "bcrypt": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  }
}
